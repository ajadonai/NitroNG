# ── Ify (WhatsApp support bot) — environment variables ──────────────────
# Copy the ones you need into your existing .env (and Vercel project env).
# Ify also reuses your existing DATABASE_URL, UPSTASH_REDIS_REST_URL/TOKEN,
# TG_BOT_TOKEN and TG_CHAT_ID — no need to duplicate those.

# --- Feature flags ---
IFY_ENABLED=true                 # master kill switch: set "false" to instantly mute Ify
IFY_ALLOWLIST=                   # soft launch: comma-separated numbers (e.g. 2348012345678,2348098765432). Empty = everyone

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_VERIFY_TOKEN=            # any random string you choose; also entered in the Meta webhook setup
WHATSAPP_APP_SECRET=              # Meta App → Settings → Basic → App Secret (verifies inbound signatures)
WHATSAPP_TOKEN=                   # WhatsApp permanent access token (System User token recommended)
WHATSAPP_PHONE_NUMBER_ID=         # WhatsApp → API Setup → Phone number ID
WHATSAPP_GRAPH_VERSION=v21.0      # optional; Graph API version

# --- LLM (OpenAI-compatible) ---
OPENAI_API_KEY=                   # your LLM API key
IFY_MODEL=gpt-4o-mini            # cheap + capable default; swap freely
IFY_LLM_BASE_URL=https://api.openai.com/v1   # point at any OpenAI-compatible endpoint
IFY_MAX_TOKENS=500
IFY_TEMPERATURE=0.3

# --- Behaviour tuning (all optional; sensible defaults in code) ---
IFY_MEMORY_TURNS=8               # how many recent messages Ify remembers per chat
IFY_MEMORY_TTL=21600             # conversation memory TTL in seconds (6h)
IFY_RL_USER=8                    # max messages/min per number (burst guard)
IFY_RL_NONUSER=20                # max messages/day for numbers with no account
IFY_HANDOFF_PAUSE=1800           # after escalation, stay quiet this many seconds (30m) for human takeover

# --- Escalation (Telegram) ---
IFY_TG_TOPIC=                    # optional: Telegram forum topic/thread id for Ify alerts (else goes to General)
