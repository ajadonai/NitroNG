{
  "regions": ["lhr1"],
  "buildCommand": "npm run deploy:check",
  "crons": [
    { "path": "/api/cron/orders", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/meta-capi", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/payments", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/promotions", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/heartbeat", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/balance", "schedule": "*/30 * * * *" },
    { "path": "/api/cron/cleanup", "schedule": "0 3 * * *" },
    { "path": "/api/cron/daily", "schedule": "0 9 * * *" },
    { "path": "/api/cron/fx", "schedule": "0 */6 * * *" },
    { "path": "/api/cron/prices", "schedule": "0 */6 * * *" },
    { "path": "/api/cron/refill", "schedule": "0 6 * * *" },
    { "path": "/api/cron/drip", "schedule": "5,15,25,35,45,55 * * * *" },
    { "path": "/api/cron/digest", "schedule": "0 5,11,17 * * *" },
    { "path": "/api/cron/digest-eod", "schedule": "59 22 * * *" },
    { "path": "/api/cron/sync-services", "schedule": "0,30 1,2,3,4 * * 0,3" },
    { "path": "/api/cron/cohort-stats", "schedule": "0 1 * * *" },
    { "path": "/api/cron/outreach-summary", "schedule": "0 19 * * 0" },
    { "path": "/api/cron/outreach-summary?period=month", "schedule": "0 20 28-31 * *" },
    { "path": "/api/cron/outreach-recycle", "schedule": "0 6 * * 2-6" },
    { "path": "/api/cron/outreach-lists?touch=day1", "schedule": "0 8 * * 2-6" },
    { "path": "/api/cron/outreach-lists?touch=day3", "schedule": "30 11 * * 2-6" },
    { "path": "/api/cron/outreach-lists?touch=backlog", "schedule": "30 13 * * 2-6" },
    { "path": "/api/cron/outreach-callbacks", "schedule": "*/15 8-17 * * 2-6" },
    { "path": "/api/cron/outreach-watchdog", "schedule": "0 16 * * 2-6" }
  ]
}
